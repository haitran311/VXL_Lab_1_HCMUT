{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "projectName",
            "type": "pickString",
            "description": "Select the project to build",
            "options": [
                "123", "lab1ex1",
                "lab1ex2",
                "lab1ex3",
                "lab1ex4"
            ],
            "default": "lab1ex2"
        }
    ],
    "tasks": [
        {
            "label": "Build STM32 Project",
            "type": "shell",
            "command": "C:\\ST\\STM32CubeIDE_1.7.0\\STM32CubeIDE\\stm32cubeidec.exe",
            "args": [
                "--launcher.suppressErrors",
                "-nosplash",
                "-application",
                "org.eclipse.cdt.managedbuilder.core.headlessbuild",
                "-import",
                "${workspaceFolder}\\${input:projectName}",
                "-build",
                "all",
                "-data",
                "${workspaceFolder}\\.metadata_headless"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "label": "Clean STM32 Project",
            "type": "shell",
            "command": "C:\\ST\\STM32CubeIDE_1.7.0\\STM32CubeIDE\\stm32cubeidec.exe",
            "args": [
                "--launcher.suppressErrors",
                "-nosplash",
                "-application",
                "org.eclipse.cdt.managedbuilder.core.headlessbuild",
                "-import",
                "${workspaceFolder}\\${input:projectName}",
                "-cleanBuild",
                "all",
                "-data",
                "${workspaceFolder}\\.metadata_headless"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}
